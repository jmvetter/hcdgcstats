# Copy to .env.local and fill in.
# Next.js treats $ as a variable reference, so write any $ in a value as \$
# (e.g. a password "ab$cd" goes in as ab\$cd).

# Password for the /admin import page.
ADMIN_PASSWORD=

# PDGA account with API access, used to refresh player ratings.
PDGA_USERNAME=
PDGA_PASSWORD=

# Optional: where the SQLite database lives (default: data/hcdgc.db).
# DATABASE_PATH=
